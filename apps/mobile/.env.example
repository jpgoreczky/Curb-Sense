# Copy to .env.local (gitignored) for local dev builds. EXPO_PUBLIC_* values
# are inlined into the app bundle: public values only, never secrets.
# For EAS builds set them per environment instead:
#   eas env:create --environment development --name EXPO_PUBLIC_MAPBOX_TOKEN --value pk.... --visibility plaintext

# Public Mapbox token (pk.*), one per environment (SETUP-1.4).
EXPO_PUBLIC_MAPBOX_TOKEN=

# Mapbox Studio style URL (UI-4.1.2). Leave empty for Mapbox Streets.
EXPO_PUBLIC_MAPBOX_STYLE_URL=

# Curb Sense API. A device can't reach "localhost" on your machine; use your LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Initial camera ("lon,lat" and zoom) until a pilot city is chosen.
EXPO_PUBLIC_INITIAL_CENTER=-73.99,40.75
EXPO_PUBLIC_INITIAL_ZOOM=13
